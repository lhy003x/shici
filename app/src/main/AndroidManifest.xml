<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shici">

        <activity
            android:name=".ui.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.study.StudyActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.Shici.Study" />

        <activity
            android:name=".ui.study.SpellActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.Shici.Study"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.widget.WidgetPreviewActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:theme="@style/Theme.Shici.Preview" />

        <receiver
            android:name=".widget.WordWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.shici.app.widget.REFRESH" />
                <action android:name="com.shici.app.widget.RATING" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MiniWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.shici.app.widget.REFRESH" />
                <action android:name="com.shici.app.widget.RATING" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_widget_info" />
        </receiver>

    </application>

</manifest>
