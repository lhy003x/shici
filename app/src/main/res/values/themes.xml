<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Shici" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_soft</item>
        <item name="colorOnPrimaryContainer">@color/green_dark</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="colorError">@color/red</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/card</item>
        <item name="materialButtonStyle">@style/Widget.Shici.Button</item>
    </style>

    <style name="Theme.Shici.Study" parent="Theme.Shici">
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <style name="Theme.Shici.Preview" parent="Theme.Shici">
        <item name="android:windowBackground">#0E211D</item>
        <item name="android:statusBarColor">#0E211D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#091412</item>
    </style>

    <style name="Widget.Shici.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Shici.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_soft</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
