<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="拾词 · 今日复习"
            android:textColor="@color/ink2"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvWidgetProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textColor="@color/green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="刷新"
            android:padding="5dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbWidget"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/line"
        android:progressTint="@color/green" />

    <TextView
        android:id="@+id/tvWidgetWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="abandon"
        android:textColor="@color/ink"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetPhonetic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="/əˈbændən/"
        android:textColor="@color/ink2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvWidgetMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="v. 放弃；抛弃"
        android:textColor="@color/ink"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWidgetExample"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="3"
        android:textColor="@color/ink3"
        android:textSize="11sp"
        android:textStyle="italic" />

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnForgot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/w_btn_forgot"
            android:gravity="center"
            android:text="忘了"
            android:textColor="@color/red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnVague"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn_vague"
            android:gravity="center"
            android:text="模糊"
            android:textColor="@color/amber"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnKnow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn_know"
            android:gravity="center"
            android:text="认识"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
